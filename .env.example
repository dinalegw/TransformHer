# Required
AUTH_SECRET=replace-with-a-long-random-string
# Optional: use a separate secret for hashing six-digit email verification codes.
# Falls back to AUTH_SECRET when omitted.
EMAIL_VERIFICATION_SECRET=

# Database (required)
POSTGRES_URL_NON_POOLING=postgres://user:pass@host/db
POSTGRES_URL=postgres://user:pass@host-pooled/db

# File Storage (Vercel Blob)
# Leave empty to use local filesystem (development).
# On Vercel, create a Blob store and paste the token here.
BLOB_READ_WRITE_TOKEN=verify+...

# Email (Courier)
COURIER_API_KEY=...
COURIER_TEMPLATE_PASSWORD_RESET=...
COURIER_TEMPLATE_PASSWORD_RESET_CONFIRMATION=...
COURIER_TEMPLATE_PASSWORD_CHANGED=...
COURIER_TEMPLATE_WELCOME_VERIFY=...
COURIER_TEMPLATE_EMAIL_VERIFICATION_CODE=...
COURIER_TEMPLATE_EMAIL_VERIFIED=...
COURIER_TEMPLATE_VERIFY_NEW_EMAIL=...
COURIER_TEMPLATE_LOGIN_NOTIFICATION=...
COURIER_TEMPLATE_SECURITY_ALERT=...
COURIER_TEMPLATE_INVITATION=...
COURIER_TEMPLATE_ACCOUNT_FROZEN=...
COURIER_TEMPLATE_ACCOUNT_ARCHIVED=...
COURIER_TEMPLATE_ACCOUNT_UNFROZEN=...
COURIER_TEMPLATE_ACCOUNT_UNARCHIVED=...
COURIER_TEMPLATE_ORDER_CONFIRMATION=...
COURIER_TEMPLATE_BOOK_RELEASED=...
COURIER_TEMPLATE_ADMIN_ORDER=...

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Admin
ADMIN_EMAIL=admin@transformher.com
ADMIN_PASSWORD=use-a-unique-long-password
# Production cold starts do not auto-seed admin/demo catalogue data by default.
# Set true only for an intentional one-time bootstrap, then turn it off again.
ALLOW_PRODUCTION_SEEDING=false

# Public application URL
# In Production, customer-facing transactional links default to
# https://transformher.vercel.app. Set this when moving to a custom domain.
TRANSFORMHER_PUBLIC_URL=https://transformher.vercel.app

# Local/preview fallback
NEXT_PUBLIC_BASE_URL=http://localhost:3000
